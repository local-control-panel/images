# ═══════════════════════════════════════════════════════════════════
#  Standalone service settings — stack versions come from versions.json
#  Copy this file to .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# PHP version bundled in FrankenPHP (8.3 / 8.4 / 8.5)
PHP_VERSION=8.3

# FrankenPHP major version (1) — combined tag: 1-php8.3
FRANKENPHP_VERSION=1

# MariaDB version (catalog line: 11.4)
MARIADB_VERSION=11.4

# Valkey versions: 9 (per-database access control for sites needs 9)
VALKEY_VERSION=9

# Valkey administrator password (the `default` user is off). Sites get their own
# users from the operations engine; this one is for the control panel only.
VALKEY_ADMIN_PASSWORD=change_me_valkey

# ═══════════════════════════════════════════════════════════════════
#  MariaDB credentials
# ═══════════════════════════════════════════════════════════════════
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_DATABASE=wordpress
MARIADB_USER=wp
MARIADB_PASSWORD=change_me_wp

# InnoDB buffer pool — set to ~25% of available RAM
# 1 GB VPS → 256M   2 GB → 512M   4 GB → 1024M   8 GB → 2048M
MARIADB_INNODB_BUFFER_POOL_SIZE=512M

# ═══════════════════════════════════════════════════════════════════
#  Valkey object cache
# ═══════════════════════════════════════════════════════════════════
# Access uses VALKEY_ADMIN_PASSWORD and per-site ACL users (see README).

# ═══════════════════════════════════════════════════════════════════
#  PostgreSQL credentials
# ═══════════════════════════════════════════════════════════════════
POSTGRES_USER=admin
# Required when starting the stack; set a unique password.
POSTGRES_PASSWORD=
POSTGRES_DB=app

# ═══════════════════════════════════════════════════════════════════
#  Meilisearch
# ═══════════════════════════════════════════════════════════════════
MEILISEARCH_VERSION=1.53.2
# Master key — must be at least 16 bytes for production
MEILISEARCH_MASTER_KEY=change_me_meilisearch_key

# ═══════════════════════════════════════════════════════════════════
#  FrankenPHP / Caddy
# ═══════════════════════════════════════════════════════════════════
# Own image published by this repository in GitHub Container Registry (GHCR).
# Override only for a private registry or a tested custom image.
# WCP_FRANKENPHP_IMAGE=ghcr.io/local-control-panel/frankenphp:1-php8.3

# Direct origin / Cloudflare proxy / trusted private reverse proxy.
# Valid values: off | cloudflare | private
CADDY_TRUSTED_PROXIES=off
CADDY_LOG_LEVEL=INFO

# The shared liveness endpoint is always http://localhost/healthcheck.
# Define domains, document roots, CSP and optional worker mode per application
# in /etc/frankenphp/Caddyfile.d/<domain>.caddyfile.

# ═══════════════════════════════════════════════════════════════════
#  Standalone per-service compose files (frankenphp/mariadb/valkey/
#  postgres/meilisearch's own docker-compose.yml — see README's "Running
#  services") join this *external* network so they can reach each other
#  across separate `docker compose up` invocations. Defaults to the
#  network stack/docker-compose.v2.yml creates under project "wcp"
#  (Compose's own `<project>_<network>` naming) — only set this if you
#  need to join a differently-named external network.
# ═══════════════════════════════════════════════════════════════════
# WCP_BACKEND_NETWORK=wcp_backend
