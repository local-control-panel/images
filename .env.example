# ═══════════════════════════════════════════════════════════════════
#  Image versions — edit here, restart containers to apply
#  Copy this file to .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# PHP version bundled in FrankenPHP (8.2 / 8.3 / 8.4)
PHP_VERSION=8.3

# FrankenPHP major version (1)  — combined tag: 1-php8.3-alpine
FRANKENPHP_VERSION=1

# MariaDB LTS versions: 10.11 (LTS) / 11.4 (LTS) / 11 (latest stable)
MARIADB_VERSION=11.4

# PostgreSQL versions: 16 / 17
POSTGRES_VERSION=17

# Valkey versions: 7.2 / 8
VALKEY_VERSION=8

# ═══════════════════════════════════════════════════════════════════
#  MariaDB credentials
# ═══════════════════════════════════════════════════════════════════
MARIADB_ROOT_PASSWORD=change_me_root
MARIADB_DATABASE=wordpress
MARIADB_USER=wp
MARIADB_PASSWORD=change_me_wp

# InnoDB buffer pool — set to ~25% of available RAM
# 1 GB VPS → 256M   2 GB → 512M   4 GB → 1024M   8 GB → 2048M
MARIADB_INNODB_BUFFER_POOL_SIZE=512M

# ═══════════════════════════════════════════════════════════════════
#  Valkey object cache
# ═══════════════════════════════════════════════════════════════════
VALKEY_VERSION=8
# Uncomment to enable password auth — also update valkey.conf requirepass and php.ini session.save_path
# VALKEY_PASSWORD=change_me_valkey

# ═══════════════════════════════════════════════════════════════════
#  PostgreSQL credentials
# ═══════════════════════════════════════════════════════════════════
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=app

# ═══════════════════════════════════════════════════════════════════
#  Meilisearch
# ═══════════════════════════════════════════════════════════════════
MEILISEARCH_VERSION=1.13
# Master key — must be at least 16 bytes for production
MEILISEARCH_MASTER_KEY=change_me_meilisearch_key

# ═══════════════════════════════════════════════════════════════════
#  FrankenPHP / Caddy
# ═══════════════════════════════════════════════════════════════════
# Own image published by this repository in GitHub Container Registry (GHCR).
# Override only for a private registry or a tested custom image.
# WCP_FRANKENPHP_IMAGE=ghcr.io/local-control-panel/frankenphp:1-php8.3

# Direct origin / Cloudflare proxy / trusted private reverse proxy.
# Valid values: off | cloudflare | private
CADDY_TRUSTED_PROXIES=off
CADDY_LOG_LEVEL=INFO

# The shared liveness endpoint is always http://localhost/healthcheck.
# Define domains, document roots, CSP and optional worker mode per application
# in /etc/frankenphp/Caddyfile.d/<domain>.caddyfile.
