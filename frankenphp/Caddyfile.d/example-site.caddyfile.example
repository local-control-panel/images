# WordPress site template — copy to <domain>.caddyfile, replace example.com
# and the site root, then review the optional rules before activating.

example.com {
    root * /var/www/example.com

    import app-common
    import wordpress-common

    # Define CSP per site after testing its theme, plugins, analytics and
    # embeds. A generic policy with unsafe-inline/unsafe-eval is not security.
    # header Content-Security-Policy "default-src 'self'"

    # Enable only after every subdomain is HTTPS-ready. Do not add preload by
    # default: it is a long-lived public commitment.
    # header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # XML-RPC is disabled by wordpress-common. Remove that import or define a
    # separate WordPress snippet if a trusted integration actually requires it.

    # Normal PHP mode is deliberate. WordPress is not a FrankenPHP worker by
    # default, so do not add a `worker index.php` directive here.
    php_server
}
