{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Single source of truth for Docker image versions. Updated automatically by .github/workflows/update-docker-versions.yml",
  "_updated": "2026-05-21",
  "platforms": ["linux/amd64", "linux/arm64"],
  "images": {
    "frankenphp": {
      "image": "dunglas/frankenphp",
      "version": "1",
      "phpVersions": ["8.2", "8.3", "8.4"],
      "phpDefault": "8.3",
      "tagPattern": "{version}-php{phpVersion}",
      "platforms": ["linux/amd64", "linux/arm64"],
      "registryUrl": "https://hub.docker.com/v2/repositories/dunglas/frankenphp/tags",
      "notes": "Multi-platform. arm64 runs natively on Apple Silicon and AWS Graviton."
    },
    "mariadb": {
      "image": "mariadb",
      "version": "11.4",
      "tagPattern": "{version}",
      "platforms": ["linux/amd64", "linux/arm64"],
      "registryUrl": "https://hub.docker.com/v2/repositories/library/mariadb/tags",
      "notes": "LTS release. Official image supports amd64 and arm64."
    },
    "postgres": {
      "image": "postgres",
      "version": "17",
      "tagPattern": "{version}",
      "platforms": ["linux/amd64", "linux/arm64"],
      "registryUrl": "https://hub.docker.com/v2/repositories/library/postgres/tags",
      "notes": "Custom image with postgresql.conf tuning baked in. Alpine base. Supports amd64 and arm64."
    },
    "valkey": {
      "image": "valkey/valkey",
      "version": "8",
      "tagPattern": "{version}-alpine",
      "platforms": ["linux/amd64", "linux/arm64"],
      "registryUrl": "https://hub.docker.com/v2/repositories/valkey/valkey/tags",
      "notes": "Redis-compatible. Alpine variant. Supports amd64 and arm64."
    },
    "meilisearch": {
      "image": "getmeili/meilisearch",
      "version": "1.13",
      "tagPattern": "v{version}",
      "platforms": ["linux/amd64", "linux/arm64"],
      "registryUrl": "https://hub.docker.com/v2/repositories/getmeili/meilisearch/tags",
      "notes": "Lightweight full-text search engine. Alternative to Elasticsearch. Rust-based, ~50MB RAM idle."
    }
  }
}
